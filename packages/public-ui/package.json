{
  "name": "@gagnechris/public-ui",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Router-free public page components: the publisher renders them to HTML and the public app hydrates them.",
  "exports": {
