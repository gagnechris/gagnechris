{
  "name": "@gagnechris/shared",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Shared TypeScript types and helpers for the site, API, and publisher.",
  "sideEffects": [
    "./src/openapi-extend.ts",
    "./src/generate-openapi.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./render": {
      "types": "./src/render.ts",
      "import": "./src/render.ts",
      "default": "./src/render.ts"
    },
    "./site-chrome": {
      "types": "./src/site-chrome-html.ts",
      "import": "./src/site-chrome-html.ts",
      "default": "./src/site-chrome-html.ts"
    },
    "./site-config": {
      "types": "./src/site-config.ts",
      "import": "./src/site-config.ts",
      "default": "./src/site-config.ts"
    },
    "./html": {
      "types": "./src/html.ts",
      "import": "./src/html.ts",
      "default": "./src/html.ts"
    },
    "./openapi": {
      "types": "./src/openapi.ts",
      "import": "./src/openapi.ts",
      "default": "./src/openapi.ts"
    }
  },
  "scripts": {
    "openapi": "tsx src/generate-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:domain-bundle": "tsx ../../scripts/check-rn-bundles.ts"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@types/node": "^22.13.0",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
