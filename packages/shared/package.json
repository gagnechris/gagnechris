{
  "name": "@gagnechris/shared",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Shared TypeScript types and helpers for the site, API, and publisher.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./render": {
      "types": "./src/render.ts",
      "import": "./src/render.ts",
      "default": "./src/render.ts"
    },
    "./openapi": {
      "types": "./src/openapi.ts",
      "import": "./src/openapi.ts",
      "default": "./src/openapi.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./html": {
      "types": "./src/html.ts",
      "import": "./src/html.ts",
      "default": "./src/html.ts"
    },
    "./home": {
      "types": "./src/home.ts",
      "import": "./src/home.ts",
      "default": "./src/home.ts"
    },
    "./resume": {
      "types": "./src/resume.ts",
      "import": "./src/resume.ts",
      "default": "./src/resume.ts"
    }
  },
  "scripts": {
    "openapi": "tsx src/generate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:domain-bundle": "tsx scripts/check-domain-bundle.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "marked": "^18.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
