#!/usr/bin/env bash
# Runs the CI checks the pushed changes can affect. Skip once with
# `git push --no-verify`.
set -euo pipefail

zero=0000000000000000000000000000000000000000
pushed=''
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # A branch deletion pushes nothing to check.
  [ "${local_sha}" = "${zero}" ] && continue
  commit="$(git rev-parse "${local_sha}^{commit}")"
  if [ -n "${pushed}" ] && [ "${pushed}" != "${commit}" ]; then
    echo "pre-push: verify checks one commit; push one branch at a time." >&2
    exit 1
  fi
  pushed="${commit}"
done

if [ -n "${pushed}" ]; then
  exec npm run --silent verify -- --pushed "${pushed}"
fi
