{
  "name": "@gagnechris/publisher",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "DynamoDB Streams publisher: static blog HTML, posts.json, sitemap, RSS.",
  "exports": {
    "./s3-site": {
      "types": "./src/s3-site.ts",
      "import": "./src/s3-site.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "publish-surface:generate": "tsx scripts/generate-publish-surface.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.25.1",
    "@aws-lambda-powertools/metrics": "^2.25.1",
    "@aws-sdk/client-cloudfront": "^3.1145.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1145.0",
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/lib-dynamodb": "^3.1145.0",
    "@aws-sdk/signature-v4a": "^3.1138.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@gagnechris/data": "*",
    "@gagnechris/shared": "*",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "pdfjs-dist": "~6.3.289",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
