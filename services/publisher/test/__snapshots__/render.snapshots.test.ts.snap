exports[`render HTML snapshots > matches frozen output for home, blog index, resume, and post 3`] = `
"<!doctype html>
<html lang="en">
  <head>
    <title>Resume - Chris Gagne</title>
    <meta name="description" content="Results-driven Director of Software Engineering with extensive experience scaling high-performing teams, driving technical vision, and delivering innovative software solutions in fast-paced…" />
    <meta property="og:title" content="Resume - Chris Gagne" />
    <meta property="og:description" content="Results-driven Director of Software Engineering with extensive experience scaling high-performing teams, driving technical vision, and delivering innovative software solutions in fast-paced…" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gagnechris.com/resume" />
    <meta property="og:image" content="https://gagnechris.com/og-image.jpg" />
    <meta name="twitter:title" content="Resume - Chris Gagne" />
    <meta name="twitter:description" content="Results-driven Director of Software Engineering with extensive experience scaling high-performing teams, driving technical vision, and delivering innovative software solutions in fast-paced…" />
    <meta name="twitter:image" content="https://gagnechris.com/og-image.jpg" />
    <link rel="canonical" href="https://gagnechris.com/resume" />
  </head>
  <body>
    <div id="root"><!--prerender:start--><header class="site-header"><a class="site-header__home" href="/"><img class="site-header__photo" alt="" width="40" height="40" src="/profile.jpg"><span class="site-header__name">Chris Gagne</span></a><nav class="site-nav" aria-label="Primary"><ul class="site-nav__list"><li><a class="site-nav__link" href="/posts">Posts</a></li><li><a class="site-nav__link" aria-current="page" href="/resume">Resume</a></li><li><a class="site-nav__link" href="/contact">Contact</a></li></ul></nav><details class="site-menu"><summary class="site-menu__button" aria-label="Menu" aria-controls="site-menu"></summary><nav class="site-menu__panel" id="site-menu" aria-label="Menu"><ul class="site-menu__list"><li><a href="/posts">Posts</a></li><li><a aria-current="page" href="/resume">Resume</a></li><li><a href="/contact">Contact</a></li></ul><ul class="site-menu__more"><li><a href="https://www.linkedin.com/in/christophergagne/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li><li><a href="https://github.com/gagnechris" target="_blank" rel="noopener noreferrer">GitHub</a></li><li><a href="/rss.xml">RSS</a></li><li><a href="/dont-feed-the-bears?from=menu">Don’t feed the bears</a></li></ul></nav></details></header><div class="resume-page resume-page-prerender" id="top" data-name="Chris Gagne" data-pdf="/resume.pdf"><header><div class="name-section"><h1>Chris Gagne</h1></div><div class="nav-section"><button class="subtle-download" aria-label="Download resume as PDF"><span class="download-icon" aria-hidden="true">↓</span><span class="download-text">Resume</span></button></div></header><main><section class="resume-summary"><h2>Summary</h2><p>Results-driven Director of Software Engineering with extensive experience scaling high-performing teams, driving technical vision, and delivering innovative software solutions in fast-paced environments. Proven track record in building engineering culture, partnering with stakeholders to define and execute product roadmaps, and implementing process improvements that enhance operational excellence and team productivity. Recognized for coaching and mentoring talent, fostering collaboration, and championing continuous improvement across the organization.</p></section><section class="resume-section"><h2>Core Competencies</h2><div class="competencies-container"><ul class="competencies-list"><li>Strategic Roadmap Development</li><li>Stakeholder Partnership</li><li>Agile &amp; Lean Methodologies</li><li>Team &amp; Culture Building</li></ul><ul class="competencies-list"><li>Continuous Improvement &amp; Operational Excellence</li><li>Technical Vision &amp; Innovation</li><li>Diversity, Equity &amp; Inclusion Advocacy</li></ul></div></section><section class="resume-section"><h2>Professional Experience</h2><div class="experience-item"><h3>Director of Software Engineering</h3><p class="company">Ro | July 2019 - Present</p><ul class="experience-list"><li>Dedicated to aligning engineering initiatives with business goals while leading a high performing team.</li><li>Spearheaded the adoption and modernization of the software development lifecycle with Agentic AI.</li><li>Instituted onboarding and incident management processes, enhancing team productivity and system reliability.</li><li>Defined the technical vision for care delivery, ensuring alignment with Ro&#39;s rapid growth and scalability.</li></ul></div><div class="experience-item"><h3>Director of Software Engineering</h3><p class="company">JW Player | March 2017 - July 2019</p><ul class="experience-list"><li>Led the transformation of the Media Engineering department, significantly enhancing our operational capabilities.</li><li>Grew the engineering team and hired three engineering managers to support our expanding team.</li><li>Established three specialized teams, each with dedicated leadership, to streamline media solutions.</li><li>Drove key vendor relationships and cost optimization initiatives, ensuring efficient resource management.</li></ul></div><div class="experience-item"><h3>Software Engineering Manager</h3><p class="company">Shutterstock | September 2014 - March 2017</p><ul class="experience-list"><li>Spearheaded transformative engineering initiatives at Shutterstock, enhancing our media systems and architecture.</li><li>Led two teams through the modernization of media metadata and ingestion systems, ensuring robust performance.</li><li>Oversaw the shift from monolithic to micro services architecture, significantly improving system reliability.</li><li>Collaborated with a Montreal-based team to create a unified data model and new APIs for better integration.</li></ul></div><div class="experience-item"><h3>Software Architect</h3><p class="company">Viacom | September 2014 - April 2015</p><ul class="experience-list"><li>Instrumental in architecting web solutions for Viacom&#39;s international brands, streamlining site-building processes.</li></ul></div><div class="experience-item"><h3>Application Development Manager</h3><p class="company">Getty Images | June 2012 - September 2014</p><ul class="experience-list"><li>Played a pivotal role in leading the development of Getty Images&#39; Digital Asset Management system, driving innovation through technology.</li><li>Championed the use of Scala, Akka, and .NET/C# to build robust applications.</li><li>Fostered a collaborative environment among developers to enhance project outcomes.</li><li>Gained expertise in cloud technologies and application performance optimization.</li></ul></div><div class="experience-item"><h3>Software Engineering Manager</h3><p class="company">Dealertrack | August 2010 - June 2012</p><ul class="experience-list"><li>Effectively managed a team dedicated to delivering robust software solutions for Dealertrack.</li><li>Directed the development of 22 applications, leveraging open-source technologies to meet customer needs.</li><li>Collaborated with cross-functional teams to prioritize and implement application changes, enhancing product offerings.</li><li>Fostered a culture of quality assurance, ensuring that both software engineers and quality analysts worked seamlessly together.</li></ul></div><div class="experience-item"><h3>Senior Software Engineer</h3><p class="company">Dealertrack | December 2004 - August 2010</p><ul class="experience-list"><li>Actively contributed to the development of critical applications and became a subject matter expert in key processes.</li><li>Developed Java EE, VB 6.0 and C# applications to support diverse business needs.</li><li>Specialized in the consolidated ACH process and the MD and VA Online Registration System (OLRS) applications.</li><li>Enhanced application performance through the creation of various supporting web applications.</li></ul></div><div class="experience-item"><h3>Software Engineer</h3><p class="company">Psyche Systems Corporation | July 2000 - December 2004</p><ul class="experience-list"><li>Developed, deployed and supported VB 6.0, VB.NET and SmallTalk Applications.</li></ul></div><div class="experience-item"><h3>Software Engineer</h3><p class="company">Daystar Corporation | January 1999 - April 2000</p><ul class="experience-list"><li>Developed and maintained applications. Supported corporate IT infrastructure.</li></ul></div></section><section class="resume-section"><h2>Technical Skills</h2><div class="competencies-container"><ul class="competencies-list"><li>Programming Languages: Python, NodeJS, React, Java, Scala, SQL</li><li>Frameworks &amp; Architecture: Microservices, Distributed Systems, RESTful APIs, Message-Driven Architectures</li><li>Cloud &amp; Infrastructure: AWS, CI/CD, Kubernetes, Docker, Infrastructure as Code (e.g. Terraform, CloudFormation)</li><li>Databases: Postgres, MySQL, Cassandra, SQL Server, NoSQL Databases</li><li>DevOps &amp; Methodologies: Agile, Scrum, Kanban</li><li>Data &amp; Analytics: AI/ML, Data Modeling, Data Migration, ETL Pipelines</li></ul></div></section><section class="resume-section"><h2>Education</h2><div class="education-item"><h3>MBA for Emerging Leaders</h3><p class="institution">University of New Haven</p><p class="location">New London, CT</p><p class="year">May 2008</p></div><div class="education-item"><h3>Bachelor&#39;s Degree in Business Management</h3><p class="institution">New England Institute of Technology</p><p class="location">Warwick, RI</p><p class="year">December 2006</p></div><div class="education-item"><h3>Associate&#39;s Degree</h3><p class="degree-detail">Computer and Network Servicing Technology</p><p class="institution">New England Institute of Technology</p><p class="location">Warwick, RI</p><p class="year">March 2000</p></div></section></main><div class="resume-page__footer-actions"><button class="subtle-download" aria-label="Download resume as PDF"><span class="download-icon" aria-hidden="true">↓</span><span class="download-text">Download Resume PDF</span></button><a class="back-link" href="#top">Back to top</a></div></div><footer class="site-footer"><p class="site-footer__copy">© 2026 Chris Gagne</p><ul class="site-footer__links"><li><a href="/rss.xml">RSS</a></li><li><a href="/dont-feed-the-bears?from=footer">Don’t feed the bears</a></li></ul></footer><!--prerender:end--></div>
    <script type="module" src="/assets/index.js"></script>
  </body>
</html>"
`;

