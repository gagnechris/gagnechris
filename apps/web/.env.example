# Cognito (public IDs — not secrets). Copy to `.env.local` for Vite.
# Prod values also live in SSM under /gagnechris/prod/cognito-*.
VITE_COGNITO_USER_POOL_ID=us-east-1_eOWvRDfYu
# Local Vite must use the dev-local client (SSM cognito-dev-client-id) for both
# apps: the prod admin-web and notebook-web clients trust only their own hosts,
# and the API rejects dev-local tokens, so local sign-in can't write production.
VITE_COGNITO_ADMIN_CLIENT_ID=REPLACE_WITH_cognito-dev-client-id
VITE_COGNITO_NOTEBOOK_CLIENT_ID=REPLACE_WITH_cognito-dev-client-id
VITE_COGNITO_AUTH_DOMAIN=auth.gagnechris.com
# Leave empty for same-origin /api via CloudFront (or Vite proxy).
# VITE_API_BASE_URL=

# Dev API proxy. Default is LOCAL — do not point at prod unless intentional.
# Unset / anything other than "prod" → http://127.0.0.1:8787 (local API).
# VITE_API_TARGET=prod
# VITE_LOCAL_API_ORIGIN=http://127.0.0.1:8787
# Local admin and Notebook without Cognito (scripts/local/env.sh sets this). Forbidden in production builds.
# VITE_AUTH_MODE=local
# Proxy publisher HTML for BlogPost fallback (scripts/local/env.sh). Not used for /blog document loads.
# VITE_LOCAL_SITE_ORIGIN=http://127.0.0.1:4177
