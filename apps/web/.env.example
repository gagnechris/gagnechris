# Cognito web client (public IDs — not secrets). Copy to `.env.local` for Vite.
# Prod values also live in SSM under /gagnechris/prod/cognito-*.
VITE_COGNITO_USER_POOL_ID=us-east-1_eOWvRDfYu
VITE_COGNITO_WEB_CLIENT_ID=3kbdi3gk4bngftgo0useo980nb
VITE_COGNITO_AUTH_DOMAIN=auth.gagnechris.com
# Leave empty for same-origin /api via CloudFront (or Vite proxy).
# VITE_API_BASE_URL=

# Dev API proxy (CHR-75). Default is LOCAL — do not point at prod unless intentional.
# Unset / anything other than "prod" → http://127.0.0.1:8787 (local API).
# VITE_API_TARGET=prod
# VITE_LOCAL_API_ORIGIN=http://127.0.0.1:8787
# Local admin without Cognito (scripts/local/env.sh sets this). Forbidden in production builds.
# VITE_AUTH_MODE=local
# Proxy publisher HTML for BlogPost fallback (scripts/local/env.sh). Not used for /blog document loads.
# VITE_LOCAL_SITE_ORIGIN=http://127.0.0.1:4177
