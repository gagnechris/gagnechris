{
  "name": "@gagnechris/web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "homepage": "https://gagnechris.com",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:prod-api": "VITE_API_TARGET=prod node scripts/dev.mjs",
    "build": "tsc -b && npm run build:public && npm run build:admin && npm run build:notebook",
    "build:public": "WEB_APP=public vite build",
    "build:admin": "WEB_APP=admin vite build",
    "build:notebook": "WEB_APP=notebook vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@gagnechris/api-client": "*",
    "@gagnechris/app-core": "*",
    "@gagnechris/public-ui": "*",
    "@gagnechris/shared": "*",
    "@gagnechris/tokens": "*",
    "@gagnechris/ui": "*",
    "@tanstack/react-query": "^5.106.1",
    "aws-amplify": "^6.22.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@gagnechris/infra": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
