{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://gagnechris.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://gagnechris.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "FF9YB7FZ7A",
        "ascAppId": "6820754784"
      }
    }
  }
}
