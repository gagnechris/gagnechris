{
  "name": "gagnechris",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w @gagnechris/web",
    "dev:prod-api": "npm run dev:prod-api -w @gagnechris/web",
    "dev:local": "npm run local:dev",
    "local:dev": "bash scripts/local/dev.sh",
    "build": "npm run build -w @gagnechris/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @gagnechris/web",
    "preview": "npm run preview -w @gagnechris/web",
    "test": "npm run test -w @gagnechris/web && npm run test -w @gagnechris/shared && npm run test -w @gagnechris/infra && npm run test -w @gagnechris/api && npm run test -w @gagnechris/publisher",
    "test:watch": "npm run test:watch -w @gagnechris/web",
    "test:coverage": "npm run test:coverage -w @gagnechris/web",
    "cdk": "npm run cdk -w @gagnechris/infra --",
    "deploy:web": "bash scripts/deploy-web.sh",
    "local:up": "docker compose -f docker-compose.local.yml up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:bootstrap": "bash -c 'source scripts/local/env.sh && node scripts/local/bootstrap-table.mjs'",
    "local:api": "bash -c 'source scripts/local/env.sh && npx tsx watch --clear-screen=false services/api/local/server.ts'",
    "local:site": "bash -c 'source scripts/local/env.sh && npx tsx services/api/local/static-server.ts'",
    "local:seed-shell": "bash scripts/local/seed-shell.sh",
    "e2e:local": "bash scripts/local/e2e.sh",
    "migrate:posts": "npx tsx scripts/migrate-posts.ts"
  },
  "engines": {
    "node": "^22.12.0"
  }
}
