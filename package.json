{
  "name": "gagnechris",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w @gagnechris/web",
    "build": "npm run build -w @gagnechris/web",
    "typecheck": "npm run typecheck -w @gagnechris/web",
    "lint": "npm run lint -w @gagnechris/web",
    "preview": "npm run preview -w @gagnechris/web",
    "deploy": "npm run deploy -w @gagnechris/web",
    "test": "npm run test -w @gagnechris/web",
    "test:watch": "npm run test:watch -w @gagnechris/web",
    "test:coverage": "npm run test:coverage -w @gagnechris/web"
  },
  "engines": {
    "node": "^22.12.0"
  }
}
