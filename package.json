{
  "name": "gagnechris",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*",
    "services/*",
    "infra",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev -w @gagnechris/web",
    "dev:prod-api": "npm run dev:prod-api -w @gagnechris/web",
    "dev:local": "npm run local:dev",
    "local:dev": "bash scripts/local/dev.sh",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && eslint scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npm run preview -w @gagnechris/web",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @gagnechris/web",
    "test:coverage": "npm run test:coverage -w @gagnechris/web",
    "cdk": "npm run cdk -w @gagnechris/infra --",
    "deploy:web": "bash scripts/deploy-web.sh",
    "local:up": "docker compose -f docker-compose.local.yml up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:bootstrap": "bash -c 'source scripts/local/env.sh && npx tsx scripts/local/bootstrap-table.ts'",
    "local:api": "bash -c 'source scripts/local/env.sh && npx tsx watch --clear-screen=false services/api/local/server.ts'",
    "local:site": "bash -c 'source scripts/local/env.sh && npx tsx services/api/local/static-server.ts'",
    "local:seed-shell": "bash scripts/local/seed-shell.sh",
    "e2e:local": "bash scripts/local/e2e.sh",
    "e2e:browser": "playwright test -c e2e/playwright.config.ts",
    "migrate:posts": "npx tsx scripts/migrate-posts.ts",
    "openapi": "npm run openapi -w @gagnechris/shared && npm run generate -w @gagnechris/api-client",
    "openapi:check": "npm run openapi && git diff --exit-code -- packages/shared/openapi/openapi.json packages/api-client/src/schema.d.ts",
    "tokens:generate": "npm run generate -w @gagnechris/tokens",
    "tokens:check": "npm run tokens:generate && git diff --exit-code -- packages/tokens/src/variables.css",
    "publish-surface:generate": "npm run publish-surface:generate -w @gagnechris/publisher",
    "publish-surface:check": "npm run publish-surface:generate && git diff --exit-code -- infra/lib/cloudfront/viewer-request-function.js packages/data/src/publish-admin-routes.generated.ts",
    "not-found:generate": "tsx apps/web/scripts/generateNotFoundFunction.ts",
    "not-found:check": "npm run not-found:generate && git diff --exit-code -- infra/lib/cloudfront/viewer-response-function.js",
    "mobile": "npm start --prefix apps/mobile",
    "check:rn-bundles": "tsx scripts/check-rn-bundles.ts",
    "check:web-shells": "tsx apps/web/scripts/checkWebShells.ts",
    "check:platform-neutral-lint": "node scripts/check-platform-neutral-lint.mjs",
    "check:tsconfig-coverage": "node scripts/check-tsconfig-coverage.mjs",
    "check:deployed-gsi": "tsx scripts/check-deployed-gsi.ts"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
